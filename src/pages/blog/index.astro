---
import BaseLayout from '../../layouts/BaseLayout.astro';

// BASE_URL es '/' en local y '/nombre-repo/' al publicar en GitHub Pages.
const base = import.meta.env.BASE_URL;

// Índice automático del blog: añade un objeto por cada artículo.
// Si cambias el título de un artículo, actualízalo también aquí.
// Las rutas se escriben sin la barra inicial: se les añade BASE_URL al renderizar.
const articulos = [
  {
    title: 'Cultura del Renacimiento',
    href: 'blog/florencia/',
    description:
      'Arte y arquitectura del Renacimiento en Florencia: el Domo, la Galería Uffizi y la Academia.',
  },
  {
    title: 'Cultura del Barroco',
    href: 'blog/roma/',
    description:
      'Historia y cultura del Barroco en Roma: el Foro, el Coliseo y los Museos Vaticanos.',
  },
];
---

<BaseLayout
  title="Blog de viajes a Italia | Turismo Italia"
  description="Artículos sobre Roma, Florencia y las principales ciudades italianas: arte, cultura, rutas y visitas guiadas."
>
  <h1>Blog de viajes a Italia</h1>
  <p>
    Ideas, rutas y recomendaciones para descubrir el patrimonio artístico y
    cultural de las ciudades italianas.
  </p>

  <ul>
    {articulos.map((articulo) => (
      <li>
        <a href={`${base}${articulo.href}`}>{articulo.title}</a>
        <p>{articulo.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
