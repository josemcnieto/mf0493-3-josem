---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Italia - turismo"
  description="Italia-todo lo necesario"
>
  <h1>Turismo en Italia</h1>
  <p>Recorrido por ciudades historicas de Italia</p>

  <img
    src={`${base}imagenes/roma.jpg`}
    alt="visa de roma"
    width="640"
    height="360"
  />
 <img
    src={`${base}imagenes/florencia.jpg`}
    alt="vista de florencia"
    width="640"
    height="360"
  />
  <h2>Lo que ofrecemos</h2>
  <p>Todas las visitas necesarias para conocer las principales ciudades.</p>
</BaseLayout>
